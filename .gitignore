## .gitignore for C# / .NET (Visual Studio, .NET Framework & modern .NET SDK)
## Docs: https://git-scm.com/docs/gitignore

# -----------------------------------------------------------------------------
# Build results (bin/obj are generated by MSBuild for every configuration)
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/

# Visual Studio / MSBuild cache and code-generated files
.vs/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.svclog
*.tlog
*.binlog
*.msbuild.log
*.pdb
*.cache
*.ilk
*.exp
*.obj

# -----------------------------------------------------------------------------
# Visual Studio user-specific files and tooling output
# -----------------------------------------------------------------------------
*.userprefs
*.sln.ide/
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
Generated_Code/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/
*.sln.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# -----------------------------------------------------------------------------
# NuGet restore output (classic .NET Framework "packages" folder)
# -----------------------------------------------------------------------------
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# -----------------------------------------------------------------------------
# Test results and code coverage (MSTest, NUnit, xUnit, dotCover, NCrunch)
# -----------------------------------------------------------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
[Tt]est[Rr]esults/
*.VisualState.xml
TestResult.xml
nunit-*.xml
*.coverage
*.coveragexml
[Cc]overage*.[Xx][Mm][Ll]
*.trx
*.NCrunch.*

# -----------------------------------------------------------------------------
# Web / desktop publishing leftovers from .NET Framework projects
# -----------------------------------------------------------------------------
_UpgradeReport_Files/
[Bb]ackup*/
UpgradeLog*.XML
UpgradeLog*.htm
AppPackages/
BundleArtifacts/
precompiledweb/
*.PrecompiledXml
*.Publish.xml

# -----------------------------------------------------------------------------
# OS / editor noise
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.swp
*.bak

